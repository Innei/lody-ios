{
  "name": "lody-ios",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "open Lody.xcodeproj",
    "ios": "pnpm prebuild && open Lody.xcodeproj",
    "prebuild": "pnpm native:assets && python3 scripts/prebuild-native.py",
    "bundle": "pnpm native:assets",
    "native:assets": "node scripts/build-decoder.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter @lody/cloud-runtime typecheck",
    "check": "pnpm typecheck && pnpm contract:check && pnpm i18n:check && pnpm native:sources && pnpm licenses:check && pnpm format:check",
    "contract": "node --experimental-strip-types packages/cloud-runtime/scripts/contract.mjs",
    "contract:check": "node --experimental-strip-types packages/cloud-runtime/scripts/contract.mjs --check",
    "i18n:check": "node scripts/check-locales.mjs",
    "native:sources": "python3 scripts/check-native-sources.py",
    "licenses:build": "node scripts/build-licenses.mjs",
    "licenses:check": "node scripts/build-licenses.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test tests/**/*.test.mjs && python3 verification/ui/runner_test.py && python3 verification/simulator_test.py && python3 verification/build_test.py && python3 verification/mac/vm_test.py",
    "verify:build": "python3 verification/build.py",
    "mac:build": "python3 verification/mac/build.py",
    "mac:dist": "python3 scripts/mac-dist.py",
    "verify:mac": "node --experimental-strip-types verification/mac/run.mts",
    "verify:mac:vm": "python3 verification/mac/vm.py",
    "verify:ui": "python3 verification/ui/run.py",
    "verify:native": "python3 verification/native.py",
    "verify:simulator": "python3 verification/simulator.py",
    "verify:clean": "python3 verification/clean.py"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "werift": "0.24.4",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@lody/cloud-runtime": "workspace:*",
    "@loro-dev/flock-wasm": "0.4.3",
    "@loro-dev/streams-client": "0.7.0",
    "@loro-dev/streams-crdt": "0.16.1",
    "@pierre/diffs": "1.4.1",
    "@rien7/anchored-overlay-kit": "0.3.0",
    "base64-js": "1.5.1",
    "diff": "9.0.0",
    "fzstd": "0.1.1",
    "loro-crdt": "1.15.1",
    "punycode": "2.3.1",
    "remend": "1.3.1",
    "zod": "3.25.76"
  }
}
