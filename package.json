{
  "name": "lody-ios",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "pnpm --filter @lody-ios/mobile start",
    "ios": "pnpm --filter @lody-ios/mobile ios",
    "prebuild": "pnpm --filter @lody-ios/mobile prebuild",
    "bundle": "pnpm --filter @lody-ios/mobile bundle",
    "typecheck": "pnpm --filter @lody-ios/mobile typecheck",
    "check": "pnpm typecheck && pnpm i18n:check && pnpm format:check",
    "i18n:check": "node apps/mobile/scripts/check-locales.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test apps/mobile/tests/**/*.test.mjs",
    "verify:ui": "python3 apps/mobile/verification/ui/run.py",
    "verify:native": "python3 apps/mobile/verification/native.py"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "babel-preset-expo": "57.0.10",
    "esbuild": "0.25.12",
    "prettier": "3.9.6"
  }
}
