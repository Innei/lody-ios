{
  "name": "lody-ios",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "pnpm --filter @lody-ios/mobile start",
    "ios": "pnpm --filter @lody-ios/mobile ios",
    "prebuild": "pnpm --filter @lody-ios/mobile prebuild",
    "bundle": "pnpm --filter @lody-ios/mobile bundle",
    "typecheck": "pnpm --filter @lody-ios/mobile typecheck",
    "check": "pnpm typecheck && pnpm contract:check && pnpm i18n:check && pnpm native:sources && pnpm licenses:check && pnpm format:check",
    "contract": "node --experimental-strip-types packages/cloud-runtime/scripts/contract.mjs",
    "contract:check": "node --experimental-strip-types packages/cloud-runtime/scripts/contract.mjs --check",
    "i18n:check": "node apps/mobile/scripts/check-locales.mjs",
    "native:sources": "python3 apps/mobile/scripts/check-native-sources.py",
    "licenses:build": "pnpm --filter @lody-ios/mobile licenses:build",
    "licenses:check": "pnpm --filter @lody-ios/mobile licenses:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test apps/mobile/tests/**/*.test.mjs && python3 apps/mobile/verification/ui/runner_test.py && python3 apps/mobile/verification/simulator_test.py && python3 apps/mobile/verification/build_test.py",
    "verify:build": "python3 apps/mobile/verification/build.py",
    "verify:ui": "python3 apps/mobile/verification/ui/run.py",
    "verify:native": "python3 apps/mobile/verification/native.py",
    "verify:simulator": "python3 apps/mobile/verification/simulator.py",
    "verify:clean": "python3 apps/mobile/verification/clean.py"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "prettier": "3.9.6"
  }
}
