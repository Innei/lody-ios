{
  "name": "@lody-ios/mobile",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "pnpm prebuild && pnpm pods && expo run:ios --no-install",
    "prebuild": "pnpm native:assets && expo prebuild --platform ios --no-install",
    "pods": "cd ios && PATH=\"$(brew --prefix ruby)/bin:$PATH\" bundle exec pod install",
    "bundle": "pnpm native:assets && EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform ios --output-dir .expo/export-check",
    "typecheck": "tsc --noEmit",
    "native:assets": "node scripts/build-decoder.mjs",
    "licenses:build": "node scripts/build-licenses.mjs",
    "licenses:check": "node scripts/build-licenses.mjs --check"
  },
  "dependencies": {
    "@expo/dom-webview": "workspace:*",
    "@expo/metro-runtime": "~58.0.14",
    "@lody/cloud-runtime": "workspace:*",
    "@loro-dev/flock-wasm": "0.4.3",
    "@loro-dev/streams-client": "0.7.0",
    "@loro-dev/streams-crdt": "0.16.1",
    "@pierre/diffs": "1.4.1",
    "@rien7/anchored-overlay-kit": "0.3.0",
    "base64-js": "1.5.1",
    "diff": "9.0.0",
    "expo": "~58.0.13",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "fzstd": "0.1.1",
    "loro-crdt": "1.15.1",
    "punycode": "2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "remend": "1.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.0",
    "@types/react": "~19.2.2",
    "expo-build-properties": "~58.0.10",
    "typescript": "~6.0.3",
    "werift": "0.24.4"
  }
}
