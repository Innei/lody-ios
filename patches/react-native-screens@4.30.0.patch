+++ b/ios/RNSScreen.mm
@@ -499,6 +499,12 @@ - (BOOL)registerContentWrapper:(RNSScreenContentWrapper *)contentWrapper content
 /// This is RNSScreenContentWrapperDelegate method, where we do get notified when React did update frame of our child.
 - (void)contentWrapper:(RNSScreenContentWrapper *)contentWrapper receivedReactFrame:(CGRect)reactFrame
 {
+  // A nested sheet wrapper can deliver its final Fabric layout after this
+  // screen has been invalidated. There is no presentation left to resize.
+  if (_controller == nil) {
+    return;
+  }
+
   // We want to update and animate allowedDetents for FormSheet only if there was a change
   // in frame's height but sometimes we receive a frame with the same dimensions mutliple times.
   // In order to prevent visual glitches, we compare new value to the old one and update
@@ -1477,10 +1483,19 @@ - (instancetype)initWithView:(UIView *)view
     _shouldNotify = YES;
     _isRemovedFromParent = NO;
     _hasNotifiedDismissed = NO;
+    // Declare the destination's bottom-bar policy before UIKit builds its
+    // navigation animator; willShow is too late for the Search glass fade.
+    self.hidesBottomBarWhenPushed = YES;
   }
   return self;
 }
 
+- (void)setToolbarItems:(NSArray<UIBarButtonItem *> *)toolbarItems animated:(BOOL)animated
+{
+  self.hidesBottomBarWhenPushed = toolbarItems.count == 0;
+  [super setToolbarItems:toolbarItems animated:animated];
+}
